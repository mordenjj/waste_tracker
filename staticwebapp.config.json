{
  "routes": [
    {
      "route": "/api/*",
      "redirect": "https://REPLACE_WITH_BACKEND_URL/api/*",
      "statusCode": 308
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/_framework/*",
      "/favicon.*",
      "*.{css,js,ico,png,svg,woff,woff2,ttf,eot}"
    ]
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
